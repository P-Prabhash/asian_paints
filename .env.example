# Paint Shop & Sunnam Bags ERP - Environment Configuration Example
# Copy this file to .env and replace with local development/production parameters

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MySQL Database Server Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paint_shop_dev
DB_USER=paint_shop_app
DB_PASSWORD=replace_with_secure_local_password

# Authentication & Security Secrets (JWT_SECRET must be at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=15m

# CORS Allowlist
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Terminal Request/Response Logging
LOG_LEVEL=debug
LOG_HTTP_BODIES=true

# Swagger / OpenAPI Documentation UI
SWAGGER_ENABLED=true
